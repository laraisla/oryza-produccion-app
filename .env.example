# AgroMatch COMEX — variables de entorno de ejemplo.
# Ninguna es obligatoria: sin valores, la app corre en modo demo con datos ficticios.
# Copiar a .env.local (ignorado por git). Nunca versionar claves reales.

# --- Supabase (solo valores públicos del proyecto; la anon key es pública por diseño y está protegida por RLS) ---
# La app hoy solo muestra si están configuradas; el adaptador de datos a Supabase está pendiente.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# NUNCA definir aquí la service_role key: con prefijo VITE_ quedaría expuesta en el navegador.

# --- Scripts Stellar (se ejecutan en Node, no en el navegador) ---
# Se leen del entorno del shell, p. ej.: set -a; . ./.env.local; set +a; npm run stellar:deploy
# Red por defecto de los scripts si no se pasa --network (testnet | local).
STELLAR_NETWORK=testnet
# RPC alternativo (opcional). Por defecto: https://soroban-testnet.stellar.org o http://localhost:8000/rpc
STELLAR_RPC_URL=
# Claves de CUENTAS DE PRUEBA (Testnet/local, sin valor). Si se omiten, los scripts generan cuentas
# en .stellar/<red>/<nombre>.secret (permisos 0600, ignorado por git) y las fondean con Friendbot.
AGROMATCH_DEPLOYER_SECRET=
AGROMATCH_SELLER_SECRET=
AGROMATCH_BUYER_SECRET=
