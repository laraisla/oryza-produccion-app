# COBRO CLARO — variables de entorno (copiá a .env.local; NUNCA subas claves al repositorio).
# La app funciona completa SIN ninguna de estas variables: la extracción con IA es opcional.

# Activa el endpoint /api/extraer. Dejalo en "false" para demos públicas.
AI_EXTRACTION_ENABLED=false

# Credencial de la API de Anthropic (solo servidor; no usar prefijo NEXT_PUBLIC_).
ANTHROPIC_API_KEY=

# Modelo a usar. Obligatorio si se activa la IA. Elegilo de la documentación
# oficial vigente del proveedor (https://platform.claude.com/docs/en/about-claude/models/overview).
EXTRACTION_MODEL=

# Opcional: esfuerzo de razonamiento (low | medium | high). Vacío = valor por defecto del modelo.
EXTRACTION_EFFORT=

# Opcional: límites de uso del endpoint (en memoria del proceso).
EXTRACTION_TIMEOUT_MS=20000
EXTRACTION_RATE_PER_MINUTE=10
EXTRACTION_DAILY_CAP=200
