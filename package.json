{
  "name": "agromatch-comex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AgroMatch COMEX: plataforma de comercialización y exportación agroindustrial (MVP arroz NEA).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "cd contracts && cargo test",
    "build:contract": "cd contracts && cargo build --target wasm32v1-none --release",
    "test:db": "bash supabase/tests/run-local.sh",
    "db:seed": "tsx --tsconfig tsconfig.node.json scripts/db/export-seed.ts",
    "stellar:deploy": "tsx --tsconfig tsconfig.node.json scripts/stellar/deploy.ts",
    "stellar:demo": "tsx --tsconfig tsconfig.node.json scripts/stellar/demo-deal.ts",
    "stellar:verify": "tsx --tsconfig tsconfig.node.json scripts/stellar/verify.ts",
    "screenshots": "tsx --tsconfig tsconfig.node.json scripts/screenshots.ts",
    "e2e": "tsx --tsconfig tsconfig.node.json scripts/e2e.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@stellar/freighter-api": "6.0.1",
    "@stellar/stellar-sdk": "17.2.1",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "lucide-react": "0.577.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router-dom": "6.30.6",
    "recharts": "2.15.4",
    "tailwind-merge": "3.7.0",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "26.1.0",
    "playwright-core": "1.57.0",
    "postcss": "8.5.30",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.2.7",
    "vitest": "3.2.7"
  }
}
